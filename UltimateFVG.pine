//@version=6
// =============================================================================
// Ultimate Fair Value Gap (FVG) Indicator
// -----------------------------------------------------------------------------
// Detects 3-candle Fair Value Gaps created by a displacement candle, scores each
// one by institutional confluence, and only draws gaps that meet a minimum score
// so the chart stays clean. Mitigation state drives both color and score.
//
// Scoring factors (configurable weights):
//   - Daily bias alignment       (prior daily close vs prior-day midpoint)
//   - Formed in an Order Block / Breaker Block
//   - Formed after a liquidity sweep of a key level (PDH/PDL/PWH/PWL/swing)
//   - Displacement strength       (gap-forming candle vs ATR)
//   - Displacement volume          (volume vs its moving average)
//   - Gap size                    (gap height vs ATR)
//
// Mitigation handling:
//   - Unmitigated         -> full color
//   - Partially mitigated -> dimmed, remaining imbalance redrawn
//   - Fully mitigated     -> muted "tested" color (or Inverted FVG), score reduced
// =============================================================================
indicator("Ultimate Fair Value Gap", shorttitle="Ult FVG", overlay=true, max_boxes_count=500, max_labels_count=500)

// ========================= INPUTS ============================================
grpF = "FVG Detection"
requireDisplacement = input.bool(true, "Require displacement candle", group=grpF, tooltip="Only flag gaps whose middle (gap-forming) candle is a strong directional move. Filters weak/noise gaps.")
minGapAtrMult   = input.float(0.10, "Min gap size (× ATR)", minval=0.0, step=0.05, group=grpF, tooltip="Gaps smaller than this fraction of ATR are ignored as noise.")
dedupeOverlap   = input.bool(true,  "Skip gaps nested inside a live gap", group=grpF, tooltip="Avoids drawing a new gap that is almost entirely contained within an existing active gap.")
maxActive       = input.int(20,     "Max FVGs tracked", minval=1, maxval=200, group=grpF, tooltip="Oldest gaps are recycled once the limit is hit.")
extendRight     = input.bool(true,  "Extend boxes to the right", group=grpF)
atrLen          = input.int(14,     "ATR length", minval=1, group=grpF)

grpScore = "Scoring Engine"
minScore        = input.int(50,     "Minimum score to draw (0-100)", minval=0, maxval=100, group=grpScore, tooltip="Only gaps scoring at least this are shown. Raise it to de-clutter.")
wBias           = input.int(22,     "Weight: Daily bias alignment", minval=0, maxval=100, group=grpScore)
wOB             = input.int(18,     "Weight: Order/Breaker block origin", minval=0, maxval=100, group=grpScore)
wSweep          = input.int(22,     "Weight: Liquidity sweep before gap", minval=0, maxval=100, group=grpScore)
wDisp           = input.int(15,     "Weight: Displacement strength", minval=0, maxval=100, group=grpScore)
wVol            = input.int(10,     "Weight: Displacement volume", minval=0, maxval=100, group=grpScore)
wSize           = input.int(13,     "Weight: Gap size", minval=0, maxval=100, group=grpScore)
mitPenalty      = input.int(30,     "Score penalty when fully mitigated", minval=0, maxval=100, group=grpScore)
dispAtrMult     = input.float(1.2,  "Displacement = candle range ≥ (× ATR)", minval=0.1, step=0.1, group=grpScore)
dispBodyPct     = input.float(0.55, "Displacement min body ratio", minval=0.1, maxval=1.0, step=0.05, group=grpScore, tooltip="Body / range of the displacement candle. Higher = stronger conviction required.")
sizeFullAtr     = input.float(0.5,  "Gap size for full size-score (× ATR)", minval=0.1, step=0.1, group=grpScore)
volMaLen        = input.int(20,     "Volume MA length", minval=1, group=grpScore)

grpStruct = "Structure (OB / Sweep)"
swingLen        = input.int(10,     "Swing lookback (pivots)", minval=2, group=grpStruct, tooltip="Used to find swing highs/lows for order blocks and sweeps.")
sweepLookback   = input.int(5,      "Sweep window (bars before gap)", minval=1, maxval=50, group=grpStruct)

grpMit = "Mitigation & Display"
mitThreshold    = input.string("Full fill", "Mitigation threshold", options=["Full fill", "Midpoint (CE)"], group=grpMit, tooltip="When is a gap considered fully mitigated: price fully fills it, or price reaches the 50% Consequent Encroachment level.")
hideMitigated   = input.bool(false, "Hide fully mitigated gaps", group=grpMit)
showInversion   = input.bool(true,  "Mark Inverted FVGs (IFVG) when traded through", group=grpMit, tooltip="A fully traded-through gap flips polarity and is kept as support/resistance instead of greyed out.")
showScore       = input.bool(true,  "Show score label on box", group=grpMit)
showGrade       = input.bool(true,  "Show letter grade (A/B/C)", group=grpMit)
showDash        = input.bool(true,  "Show dashboard (top-right)", group=grpMit)
showKeyLevels   = input.bool(true,  "Plot PDH/PDL/PWH/PWL", group=grpMit)

grpColor = "Colors"
colBull     = input.color(color.new(#26a69a, 70), "Bullish FVG", group=grpColor)
colBear     = input.color(color.new(#ef5350, 70), "Bearish FVG", group=grpColor)
colPartial  = input.color(color.new(#ffb74d, 60), "Partially mitigated", group=grpColor)
colTested   = input.color(color.new(#9e9e9e, 80), "Fully mitigated (tested)", group=grpColor)
colInv      = input.color(color.new(#ab47bc, 65), "Inverted FVG (IFVG)", group=grpColor)
colText     = input.color(color.white, "Label text", group=grpColor)

// ========================= HTF DATA (DAILY / WEEKLY) =========================
// Previous day/week high/low/close via confirmed-bar security requests.
pdh = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_on)
pdc = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
pwh = request.security(syminfo.tickerid, "W", high[1],  lookahead=barmerge.lookahead_on)
pwl = request.security(syminfo.tickerid, "W", low[1],   lookahead=barmerge.lookahead_on)

// Daily bias: prior daily close relative to prior-day midpoint.
pdMid    = (pdh + pdl) / 2.0
biasBull = pdc > pdMid
biasBear = pdc < pdMid

atr   = ta.atr(atrLen)
volMa = ta.sma(volume, volMaLen)

// ========================= STRUCTURE: PIVOTS ================================
ph = ta.pivothigh(swingLen, swingLen)
pl = ta.pivotlow(swingLen, swingLen)

var float lastSwingHigh = na
var float lastSwingLow  = na
if not na(ph)
    lastSwingHigh := ph
if not na(pl)
    lastSwingLow := pl

// ========================= FVG TYPE (UDT) ====================================
type FVG
    box    bx
    label  lbl
    float  top
    float  bot
    float  origTop
    float  origBot
    bool   bull        // original polarity
    int    score
    int    createdBar
    int    state       // 0 = unmitigated, 1 = partial, 2 = fully mitigated/inverted
    bool   inverted    // true once traded fully through and kept as IFVG
    bool   alive

var array<FVG> fvgs = array.new<FVG>()

// ========================= HELPERS ===========================================
grade(int s) =>
    s >= 85 ? "A+" : s >= 75 ? "A" : s >= 65 ? "B" : s >= 55 ? "C" : "D"

colorFor(FVG f) =>
    f.inverted ? colInv : f.state == 2 ? colTested : f.state == 1 ? colPartial : (f.bull ? colBull : colBear)

// Was a key level swept within the sweep window ending at the gap-forming candle?
// A sweep = wick pierced the level but close returned back through it.
sweptKeyLevel(bool bull) =>
    bool found = false
    for i = 1 to sweepLookback
        hi = high[i]
        lo = low[i]
        cl = close[i]
        if bull
            if (not na(pdl) and lo < pdl and cl > pdl) or (not na(pwl) and lo < pwl and cl > pwl) or (not na(lastSwingLow) and lo < lastSwingLow and cl > lastSwingLow)
                found := true
        else
            if (not na(pdh) and hi > pdh and cl < pdh) or (not na(pwh) and hi > pwh and cl < pwh) or (not na(lastSwingHigh) and hi > lastSwingHigh and cl < lastSwingHigh)
                found := true
    found

// Order/breaker block origin proxy: opposite-color candle right before the
// displacement candle (bar [2] relative to the just-closed detection bar).
obOrigin(bool bull) =>
    bull ? (close[2] < open[2]) : (close[2] > open[2])

// Displacement candle = the middle bar [1]. Strong directional candle:
// range >= ATR mult AND body dominates range AND closes in gap direction.
dispRange = high[1] - low[1]
dispBody  = math.abs(close[1] - open[1])
dispBullOK = (close[1] > open[1]) and dispRange >= atr * dispAtrMult and (dispBody / math.max(dispRange, syminfo.mintick)) >= dispBodyPct
dispBearOK = (close[1] < open[1]) and dispRange >= atr * dispAtrMult and (dispBody / math.max(dispRange, syminfo.mintick)) >= dispBodyPct

// ========================= FVG DETECTION =====================================
// Classic 3-candle FVG on bars [2],[1],[0]. Gap defined by bar2 and bar0.
bullFVG = low > high[2]
bearFVG = high < low[2]

gapTopBull = low
gapBotBull = high[2]
gapTopBear = low[2]
gapBotBear = high

sizeOkBull = (gapTopBull - gapBotBull) >= atr * minGapAtrMult
sizeOkBear = (gapTopBear - gapBotBear) >= atr * minGapAtrMult

dispOkBull = not requireDisplacement or dispBullOK
dispOkBear = not requireDisplacement or dispBearOK

newBull = bullFVG and sizeOkBull and dispOkBull
newBear = bearFVG and sizeOkBear and dispOkBear

// Is a candidate gap nested inside an existing live gap of the same polarity?
nestedInLive(bool bull, float top, float bot) =>
    bool nested = false
    if dedupeOverlap and array.size(fvgs) > 0
        for i = 0 to array.size(fvgs) - 1
            FVG f = array.get(fvgs, i)
            if f.alive and f.state < 2 and f.bull == bull
                // candidate largely within existing live zone
                if top <= f.top and bot >= f.bot
                    nested := true
    nested

computeScore(bool bull, float gapTop, float gapBot) =>
    int s = 0
    if (bull and biasBull) or (not bull and biasBear)
        s := s + wBias
    if obOrigin(bull)
        s := s + wOB
    if sweptKeyLevel(bull)
        s := s + wSweep
    // Displacement strength (scaled by how far beyond the ATR threshold it is)
    dstrength = math.min(1.0, dispRange / (atr * dispAtrMult))
    s := s + int(wDisp * dstrength)
    // Displacement volume
    volFrac = na(volMa) or volMa == 0 ? 0.0 : math.min(1.0, volume[1] / volMa)
    s := s + int(wVol * volFrac)
    // Gap size
    gh = gapTop - gapBot
    sizeFrac = math.min(1.0, gh / (atr * sizeFullAtr))
    s := s + int(wSize * sizeFrac)
    math.min(100, s)

makeLabelText(FVG f, int effScore) =>
    gr = showGrade ? grade(effScore) : ""
    sc = showScore ? str.tostring(effScore) : ""
    base = gr + (gr != "" and sc != "" ? " " : "") + sc
    tail = f.inverted ? " ·IFVG" : f.state == 2 ? " ·tested" : f.state == 1 ? " ·partial" : ""
    base + tail

makeFVG(bool bull, float gapTop, float gapBot) =>
    if not nestedInLive(bull, gapTop, gapBot)
        int sc = computeScore(bull, gapTop, gapBot)
        if sc >= minScore
            col = bull ? colBull : colBear
            bx = box.new(bar_index - 1, gapTop, bar_index, gapBot, border_color=col, bgcolor=col, extend=extendRight ? extend.right : extend.none)
            lb = (showScore or showGrade) ? label.new(bar_index - 1, gapTop, "", style=bull ? label.style_label_down : label.style_label_up, color=color.new(chart.bg_color, 100), textcolor=colText, size=size.small) : na
            FVG f = FVG.new(bx, lb, gapTop, gapBot, gapTop, gapBot, bull, sc, bar_index, 0, false, true)
            if not na(lb)
                label.set_text(lb, makeLabelText(f, sc))
            array.push(fvgs, f)
            if array.size(fvgs) > maxActive
                FVG old = array.shift(fvgs)
                box.delete(old.bx)
                if not na(old.lbl)
                    label.delete(old.lbl)

if barstate.isconfirmed
    if newBull
        makeFVG(true, gapTopBull, gapBotBull)
    if newBear
        makeFVG(false, gapTopBear, gapBotBear)

// ========================= MITIGATION UPDATE =================================
useCE = mitThreshold == "Midpoint (CE)"

if barstate.isconfirmed and array.size(fvgs) > 0
    for i = array.size(fvgs) - 1 to 0
        FVG f = array.get(fvgs, i)
        if not f.alive
            continue

        ce = (f.origTop + f.origBot) / 2.0   // consequent encroachment (50%)

        if not f.inverted
            if f.bull
                // Bullish gap sits below price; price trades DOWN into it.
                fullLevel = useCE ? ce : f.origBot
                if low <= fullLevel
                    f.state := 2
                else if low < f.origTop
                    // partial: imbalance consumed from the top down to current low
                    f.state := 1
                    f.top := low
            else
                // Bearish gap sits above price; price trades UP into it.
                fullLevel = useCE ? ce : f.origTop
                if high >= fullLevel
                    f.state := 2
                else if high > f.origBot
                    f.state := 1
                    f.bot := high
        else
            // Inverted FVG: polarity flipped. Treat the original zone as S/R.
            // Re-mitigation of an IFVG retires it.
            if f.bull  // was bullish, now acting as resistance after trade-through
                if high >= f.origTop
                    f.alive := false
            else       // was bearish, now acting as support
                if low <= f.origBot
                    f.alive := false

        // Transition to inverted (IFVG) instead of plain tested, if enabled
        if f.state == 2 and showInversion and not f.inverted
            f.inverted := true
            f.top := f.origTop
            f.bot := f.origBot

        // Handle hide / retire
        if (f.state == 2 and hideMitigated and not showInversion) or not f.alive
            box.delete(f.bx)
            if not na(f.lbl)
                label.delete(f.lbl)
            array.remove(fvgs, i)
            continue

        // Apply visuals
        col = colorFor(f)
        box.set_bgcolor(f.bx, col)
        box.set_border_color(f.bx, col)
        box.set_top(f.bx, f.top)
        box.set_bottom(f.bx, f.bot)
        if f.state == 2 and not f.inverted
            box.set_extend(f.bx, extend.none)
            box.set_right(f.bx, bar_index)

        effScore = (f.state == 2 and not f.inverted) ? math.max(0, f.score - mitPenalty) : f.score
        if not na(f.lbl)
            label.set_text(f.lbl, makeLabelText(f, effScore))
            label.set_textcolor(f.lbl, colText)
            label.set_x(f.lbl, bar_index)
            label.set_y(f.lbl, f.bull ? f.top : f.bot)
        array.set(fvgs, i, f)

// ========================= KEY LEVELS ========================================
plot(showKeyLevels ? pdh : na, "PDH", color=color.new(color.red, 30),   style=plot.style_linebr, linewidth=1)
plot(showKeyLevels ? pdl : na, "PDL", color=color.new(color.green, 30), style=plot.style_linebr, linewidth=1)
plot(showKeyLevels ? pwh : na, "PWH", color=color.new(color.red, 60),   style=plot.style_linebr, linewidth=1)
plot(showKeyLevels ? pwl : na, "PWL", color=color.new(color.green, 60), style=plot.style_linebr, linewidth=1)

// ========================= DASHBOARD =========================================
var table dash = table.new(position.top_right, 2, 5, border_width=1, frame_color=color.new(color.gray, 50), frame_width=1)
if showDash and barstate.islast
    biasTxt = biasBull ? "Bullish" : biasBear ? "Bearish" : "Neutral"
    biasCol = biasBull ? color.new(color.green, 0) : biasBear ? color.new(color.red, 0) : color.new(color.gray, 0)
    int activeCount = 0
    int aGrade = 0
    if array.size(fvgs) > 0
        for i = 0 to array.size(fvgs) - 1
            FVG f = array.get(fvgs, i)
            if f.alive and f.state < 2
                activeCount += 1
                if f.score >= 75
                    aGrade += 1
    table.cell(dash, 0, 0, "Ultimate FVG", text_color=color.white, bgcolor=color.new(color.blue, 20), text_size=size.small)
    table.cell(dash, 1, 0, "", bgcolor=color.new(color.blue, 20))
    table.cell(dash, 0, 1, "Daily Bias", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, biasTxt, text_color=color.white, bgcolor=biasCol, text_size=size.small)
    table.cell(dash, 0, 2, "Active FVGs", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(activeCount), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 3, "A-grade active", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(aGrade), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 4, "Min score", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(minScore), text_color=color.white, text_size=size.small)

// ========================= ALERTS ============================================
alertcondition(newBull, "New Bullish FVG", "A new bullish Fair Value Gap formed")
alertcondition(newBear, "New Bearish FVG", "A new bearish Fair Value Gap formed")
