//@version=6
// =============================================================================
// ULTIMATE FVG & ORDER BLOCK DETECTION ENGINE
// -----------------------------------------------------------------------------
// Scores every Fair Value Gap (FVG) and Order Block (OB) from 0-100 using
// measurable conditions only (ATR size, displacement, structure, liquidity,
// premium/discount, volume, higher-timeframe alignment, freshness, FVG/OB
// confluence). The score is a rule-based quality rating, NOT a win probability.
//
// Non-repainting design
//   * All detection / lifecycle state is mutated only on confirmed (closed) bars.
//   * Pivots are used only after their right-hand bars have closed.
//   * Higher-timeframe data: "confirmed only" mode uses [1] + lookahead_on,
//     which returns the last COMPLETED HTF bar (no future data).
//   * Every zone stores a formation time and a (later) confirmation time.
//   * Drawing is a pure view of stored state (rebuilt on the last bar only).
// =============================================================================
indicator("Ultimate FVG & Order Block Engine", shorttitle="UFOB", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500, max_bars_back=500)

// =============================================================================
// 1. INPUTS
// =============================================================================
G_PRE = "01 Preset"
G_DET = "02 FVG detection & ATR"
G_DSP = "03 Displacement"
G_STR = "04 Structure & liquidity"
G_RNG = "05 Premium / discount"
G_OB  = "06 Order blocks"
G_CNF = "07 FVG + OB confluence"
G_VOL = "08 Volume"
G_HTF = "09 Higher timeframes"
G_WGT = "10 Score weights"
G_LIF = "11 Mitigation & invalidation"
G_DIS = "12 Display"
G_LBL = "13 Label fields"
G_COL = "14 Colors"
G_DSH = "15 Dashboard"
G_ALT = "16 Alerts"
G_DGN = "17 Diagnostics & statistics"

// ---- Preset --------------------------------------------------------------
presetSel   = input.string("Intraday", "Preset", options=["Scalping", "Intraday", "Swing"], group=G_PRE, tooltip="Initializes the values below. Any override that is not 0 / 'Preset' wins over the preset.\nScalping: run on 1m/3m/5m, HTF 15m/1H.\nIntraday: run on 5m/15m, HTF 1H/4H.\nSwing: run on 1H/4H, HTF D/W.\nZone detection always runs on the CHART timeframe.")
extLenOvr   = input.int(0, "External swing length (0 = preset)", minval=0, maxval=100, group=G_PRE)
intLenOvr   = input.int(0, "Internal swing length (0 = preset)", minval=0, maxval=50, group=G_PRE)
minScoreOvr = input.int(0, "Minimum display score (0 = preset)", minval=0, maxval=100, group=G_PRE)
proxOvr     = input.float(0.0, "Max zone distance in ATR (0 = preset)", minval=0.0, step=0.5, group=G_PRE)
sweepLbOvr  = input.int(0, "Sweep look-back bars (0 = preset)", minval=0, maxval=100, group=G_PRE)
dispMinOvr  = input.float(0.0, "Displacement min body in ATR (0 = preset)", minval=0.0, step=0.05, group=G_PRE)

// ---- FVG detection / ATR ---------------------------------------------------
atrLen    = input.int(14, "ATR length", minval=1, group=G_DET)
atrClamp  = input.float(2.5, "Volatility clamp (x 50-bar avg true range)", minval=1.0, step=0.1, group=G_DET, tooltip="True range is capped at this multiple of its 50-bar average before the ATR is built, so a single news bar cannot inflate the ATR (and therefore deflate every ratio).")
atrSrc    = input.string("Chart timeframe", "Normalize FVG size by", options=["Chart timeframe", "Higher timeframe (slot 1)"], group=G_DET, tooltip="HTF ATR is the last COMPLETED HTF bar's ATR. If you use it, rescale the thresholds below.")
thrRej    = input.float(0.10, "Reject below (ATR)", minval=0.0, step=0.01, group=G_DET)
thrWeak   = input.float(0.20, "Weak up to (ATR)", minval=0.0, step=0.01, group=G_DET)
thrMod    = input.float(0.35, "Moderate up to (ATR)", minval=0.0, step=0.01, group=G_DET)
thrStrong = input.float(0.60, "Strong up to (ATR); above = Very strong", minval=0.0, step=0.01, group=G_DET)

// ---- Displacement ----------------------------------------------------------
dispFullBody = input.float(1.2, "Body size for full credit (ATR)", minval=0.1, step=0.1, group=G_DSP)
dispFullExp  = input.float(2.0, "Range expansion for full credit (x avg range)", minval=1.1, step=0.1, group=G_DSP)

// ---- Structure & liquidity ---------------------------------------------------
structWindow = input.int(3, "FVG structure window (bars)", minval=1, maxval=10, group=G_STR, tooltip="A structure break counts for an FVG if it occurred within this many bars up to and including the bar that confirmed the FVG.")
eqTolAtr     = input.float(0.10, "Equal highs/lows tolerance (ATR)", minval=0.0, step=0.01, group=G_STR)
useDaily     = input.bool(true, "Previous day high/low sweeps", group=G_STR)
useWeekly    = input.bool(true, "Previous week high/low sweeps", group=G_STR)
useEqLiq     = input.bool(true, "Equal highs/lows sweeps", group=G_STR)
useSwingLiq  = input.bool(true, "Swing high/low sweeps", group=G_STR)

// ---- Premium / discount ----------------------------------------------------
useExtRange = input.bool(true, "External range (major swings)", group=G_RNG)
useIntRange = input.bool(false, "Internal range (recent swings)", group=G_RNG)
useHtfRange = input.bool(true, "Higher-timeframe range", group=G_RNG)
htfRngSlot  = input.int(1, "HTF range source slot", minval=1, maxval=3, group=G_RNG)
htfPiv      = input.int(5, "HTF swing length", minval=2, maxval=30, group=G_RNG)
eqTolPct    = input.float(5.0, "Equilibrium tolerance (% of range, each side)", minval=0.0, maxval=25.0, step=0.5, group=G_RNG)
sweetPct    = input.float(30.0, "Best-location band (% of range from the extreme)", minval=10.0, maxval=45.0, step=1.0, group=G_RNG)
rngMinAtr   = input.float(2.0, "Minimum dealing range height (ATR)", minval=0.0, step=0.5, group=G_RNG, tooltip="The external/internal range only updates when the newest swing pair spans at least this many ATR, so insignificant swings do not shift it.")

// ---- Order blocks ------------------------------------------------------------
obBoundary   = input.string("Full candle range", "OB boundary", options=["Full candle range", "Body only", "Hybrid (body + wick %)"], group=G_OB)
obWickPct    = input.float(25.0, "Hybrid: wick percentage included", minval=0.0, maxval=100.0, group=G_OB)
obMinLegAtr  = input.float(1.5, "Min displacement leg (ATR)", minval=0.0, step=0.1, group=G_OB)
obMinRngAtr  = input.float(0.3, "Min OB candle range (ATR)", minval=0.0, step=0.05, group=G_OB)
obMaxRngAtr  = input.float(4.0, "Max OB candle range (ATR)", minval=0.5, step=0.1, group=G_OB)
obErMin      = input.float(0.20, "Min leg efficiency (chop filter, 0-1)", minval=0.0, maxval=1.0, step=0.05, group=G_OB, tooltip="Efficiency ratio over the OB candle -> break span (net move / path travelled). Low values mean the block formed in choppy consolidation and is rejected.")
obReqExt     = input.bool(false, "Require EXTERNAL structure break", group=G_OB)

// ---- Confluence ----------------------------------------------------------------
confBonus   = input.float(8.0, "FVG bonus points for OB confluence", minval=0.0, maxval=30.0, step=0.5, group=G_CNF, tooltip="Added on top of the FVG score (capped at 100). Order blocks have their own 'FVG confluence' weight instead.")
confNearAtr = input.float(0.5, "'Nearby' distance (ATR)", minval=0.05, step=0.05, group=G_CNF)
confMaxBars = input.int(60, "Max formation distance between FVG and OB (bars)", minval=1, group=G_CNF)
mergeOn     = input.bool(false, "Merge overlapping FVG + OB into one drawn zone", group=G_CNF)

// ---- Volume ----------------------------------------------------------------------
useVol   = input.bool(true, "Use volume in scoring", group=G_VOL, tooltip="Volume is supporting evidence only. If disabled (or the symbol has no volume) its weight is removed and the score is re-normalized.")
volLen   = input.int(20, "Volume SMA length", minval=2, group=G_VOL)
volHigh  = input.float(2.0, "Relative volume for full credit (x SMA)", minval=1.1, step=0.1, group=G_VOL)

// ---- Higher timeframes -----------------------------------------------------------
confirmedOnly = input.bool(true, "Confirmed HTF candles only (no repaint)", group=G_HTF, tooltip="ON: uses the last COMPLETED higher-timeframe bar. OFF: uses the developing HTF bar, which can change until it closes (repaints).")
slotIn1 = input.string("Preset", "HTF slot 1", options=["Preset", "Off", "1", "3", "5", "15", "30", "60", "120", "240", "D", "W", "M"], group=G_HTF)
slotIn2 = input.string("Preset", "HTF slot 2", options=["Preset", "Off", "1", "3", "5", "15", "30", "60", "120", "240", "D", "W", "M"], group=G_HTF)
slotIn3 = input.string("Preset", "HTF slot 3", options=["Preset", "Off", "1", "3", "5", "15", "30", "60", "120", "240", "D", "W", "M"], group=G_HTF)
slotSc1 = input.bool(true, "Slot 1 contributes to score", group=G_HTF)
slotSc2 = input.bool(true, "Slot 2 contributes to score", group=G_HTF)
slotSc3 = input.bool(true, "Slot 3 contributes to score", group=G_HTF)

// ---- Weights -----------------------------------------------------------------------
wF_size  = input.float(15.0, "FVG: ATR-normalized size", minval=0.0, group=G_WGT)
wF_disp  = input.float(20.0, "FVG: displacement", minval=0.0, group=G_WGT)
wF_pd    = input.float(20.0, "FVG: premium/discount", minval=0.0, group=G_WGT)
wF_str   = input.float(15.0, "FVG: BOS/MSS", minval=0.0, group=G_WGT)
wF_liq   = input.float(10.0, "FVG: liquidity sweep", minval=0.0, group=G_WGT)
wF_vol   = input.float(5.0, "FVG: volume", minval=0.0, group=G_WGT)
wF_htf   = input.float(10.0, "FVG: HTF alignment", minval=0.0, group=G_WGT)
wF_fresh = input.float(5.0, "FVG: freshness", minval=0.0, group=G_WGT)
wO_atr   = input.float(10.0, "OB: ATR characteristics", minval=0.0, group=G_WGT)
wO_disp  = input.float(20.0, "OB: displacement", minval=0.0, group=G_WGT)
wO_pd    = input.float(20.0, "OB: premium/discount", minval=0.0, group=G_WGT)
wO_str   = input.float(15.0, "OB: BOS/MSS", minval=0.0, group=G_WGT)
wO_liq   = input.float(10.0, "OB: liquidity sweep", minval=0.0, group=G_WGT)
wO_vol   = input.float(0.0, "OB: volume (0 = off, not in the default table)", minval=0.0, group=G_WGT)
wO_conf  = input.float(10.0, "OB: FVG confluence", minval=0.0, group=G_WGT)
wO_htf   = input.float(10.0, "OB: HTF alignment", minval=0.0, group=G_WGT)
wO_fresh = input.float(5.0, "OB: freshness", minval=0.0, group=G_WGT)

// ---- Mitigation --------------------------------------------------------------------
invRule       = input.string("Close beyond zone", "Invalidation rule", options=["Close beyond zone", "Wick beyond zone", "Full-body penetration", "Structure-based"], group=G_LIF, tooltip="Beyond zone = beyond the FAR edge. Structure-based: an opposing BOS/CHoCH/MSS prints while price closes inside or beyond the zone.")
showMitigated = input.bool(false, "Show mitigated / invalidated zones", group=G_LIF)
showCE        = input.bool(true, "Show 50% midpoint (consequent encroachment)", group=G_LIF)

// ---- Display -----------------------------------------------------------------------
dispMode    = input.string("FVG + OB", "Show", options=["FVG + OB", "FVG only", "OB only", "Overlapping FVG/OB only"], group=G_DIS)
highOnly    = input.bool(false, "Only high-quality zones", group=G_DIS)
hiQ         = input.int(80, "High-quality threshold", minval=1, maxval=100, group=G_DIS)
showHist    = input.bool(false, "Show historical zones (older than the window)", group=G_DIS)
histBars    = input.int(500, "Historical window (bars)", minval=10, group=G_DIS)
nearestOnly = input.bool(false, "Show only nearest zones to price", group=G_DIS)
nearestN    = input.int(4, "Nearest zones to keep", minval=1, maxval=50, group=G_DIS)
maxZones    = input.int(8, "Max zones drawn", minval=1, maxval=50, group=G_DIS)
extendOn    = input.bool(true, "Extend active zones until mitigation", group=G_DIS)
extBars     = input.int(15, "Extension past last bar (bars)", minval=1, maxval=200, group=G_DIS)
showEqLines = input.bool(false, "Show dealing-range high / low / 50% lines", group=G_DIS)
showStruct  = input.bool(true, "Show structure-break markers", group=G_DIS)

// ---- Labels ------------------------------------------------------------------------
showLabels = input.bool(true, "Show labels", group=G_LBL)
lblType    = input.bool(true, "Type & direction", group=G_LBL)
lblScore   = input.bool(true, "Score", group=G_LBL)
lblSize    = input.bool(true, "Size (ATR)", group=G_LBL)
lblLoc     = input.bool(true, "Location", group=G_LBL)
lblStruct  = input.bool(true, "Structure", group=G_LBL)
lblLiq     = input.bool(true, "Liquidity", group=G_LBL)
lblStatus  = input.bool(true, "Status", group=G_LBL)
lblConf    = input.bool(true, "Confluence", group=G_LBL)
lblSizeSel = input.string("tiny", "Label size", options=["tiny", "small", "normal"], group=G_LBL)

// ---- Colors ------------------------------------------------------------------------
colBullFvg = input.color(#26a69a, "Bullish FVG", group=G_COL)
colBearFvg = input.color(#ef5350, "Bearish FVG", group=G_COL)
colBullOb  = input.color(#1b5e20, "Bullish OB", group=G_COL)
colBearOb  = input.color(#7f1d1d, "Bearish OB", group=G_COL)

// ---- Dashboard ---------------------------------------------------------------------
showDash  = input.bool(true, "Show dashboard", group=G_DSH)
dashPosIn = input.string("Top right", "Position", options=["Top right", "Top left", "Bottom right", "Bottom left", "Middle right", "Middle left"], group=G_DSH)
showStats = input.bool(true, "Include historical statistics rows", group=G_DSH)

// ---- Alerts ------------------------------------------------------------------------
alertFnOn = input.bool(true, "Send detailed alert() messages", group=G_ALT, tooltip="Create ONE alert on this script with 'Any alert() function call'. The individual alertcondition() entries are also available. Do not enable both for the same event or you will get duplicates.")
aNewFvg   = input.int(75, "New FVG min score", minval=0, maxval=100, group=G_ALT)
aNewOb    = input.int(75, "New OB min score", minval=0, maxval=100, group=G_ALT)
aConfl    = input.int(75, "Confluence min score", minval=0, maxval=100, group=G_ALT)
aAppr     = input.int(75, "Approaching min score", minval=0, maxval=100, group=G_ALT)
aEnter    = input.int(75, "Entering min score", minval=0, maxval=100, group=G_ALT)
aInval    = input.int(70, "Invalidation min score", minval=0, maxval=100, group=G_ALT)
aMitig    = input.int(70, "Mitigation min score", minval=0, maxval=100, group=G_ALT)
aTop      = input.int(90, "Top-tier min score", minval=0, maxval=100, group=G_ALT)
apprAtr   = input.float(1.0, "'Approaching' distance (ATR)", minval=0.1, step=0.1, group=G_ALT)

// ---- Diagnostics -------------------------------------------------------------------
diagTip      = input.bool(true, "Detailed score breakdown in label tooltip (hover)", group=G_DGN)
showInsp     = input.bool(false, "Show zone inspector table", group=G_DGN)
inspRank     = input.int(1, "Inspect drawn zone #", minval=1, maxval=50, group=G_DGN, tooltip="Rank among the drawn zones (highest score first, or nearest first when 'nearest only' is on).")
inspPosIn    = input.string("Bottom left", "Inspector position", options=["Top right", "Top left", "Bottom right", "Bottom left", "Middle right", "Middle left"], group=G_DGN)
statsHorizon = input.int(30, "Outcome horizon (bars)", minval=1, maxval=500, group=G_DGN)
statsExc     = input.float(1.0, "Favorable excursion target (ATR)", minval=0.1, step=0.1, group=G_DGN)

// =============================================================================
// 2. EFFECTIVE (PRESET-RESOLVED) PARAMETERS
// =============================================================================
bool isScalp = presetSel == "Scalping"
bool isSwing = presetSel == "Swing"
int extLen = extLenOvr > 0 ? extLenOvr : isScalp ? 8 : isSwing ? 15 : 12
int intLen = intLenOvr > 0 ? intLenOvr : isScalp ? 2 : isSwing ? 5 : 3
int minScoreEff = minScoreOvr > 0 ? minScoreOvr : isScalp ? 65 : isSwing ? 60 : 65
float proxAtr = proxOvr > 0 ? proxOvr : isScalp ? 6.0 : isSwing ? 20.0 : 10.0
int sweepLb = sweepLbOvr > 0 ? sweepLbOvr : isScalp ? 8 : isSwing ? 20 : 12
float dispMinEff = dispMinOvr > 0 ? dispMinOvr : isScalp ? 0.9 : 1.0
// preset emphasis (multiplies weights; the score is re-normalized to 0-100)
float mDisp = isScalp ? 1.3 : 1.0
float mPd = (not isScalp and not isSwing) ? 1.25 : 1.0
float mLiq = (not isScalp and not isSwing) ? 1.25 : 1.0
float mStr = isSwing ? 1.2 : 1.0
float mHtf = isSwing ? 1.2 : 1.0
string presetDetect = isScalp ? "1, 3, 5" : isSwing ? "60, 240" : "5, 15"
array<string> detectTfs = isScalp ? array.from("1", "3", "5") : isSwing ? array.from("60", "240") : array.from("5", "15")
int storeFloor = math.max(0, minScoreEff - 15)
int maxStore = 150

// =============================================================================
// 3. TYPES
// =============================================================================
type Zone
    int uid
    bool isFvg
    bool isBull
    float top
    float bot
    int startTime
    int formBar
    int formTime
    int confBar
    int confTime
    float atrForm = 1.0
    float atrRatio = 0.0
    float dispAtr = 0.0
    float pos = na
    string locTxt = "n/a"
    string structTxt = "None"
    string liqTxt = "None"
    string htfTxt = "n/a"
    string sizeTxt = ""
    string confTxt = "None"
    string pdTxt = "n/a"
    float fSize = 0.0
    float fDisp = 0.0
    float fPD = 0.0
    float fStruct = 0.0
    float fLiq = 0.0
    float fVol = 0.0
    float fConf = 0.0
    float fHtf = 0.0
    bool pdOk = false
    bool htfOk = false
    bool volOk = false
    float score = 0.0
    int cls = 0
    int status = 0
    float depth = 0.0
    int touches = 0
    bool inside = false
    bool active = true
    int endBar
    int endTime
    int partnerId = 0
    bool approachSent = false
    int touchBar
    float refPrice
    float mfe = 0.0
    float mae = 0.0
    bool resolved = false

type Stats
    int seq = 0
    int detected = 0
    int nExc = 0
    int nHigh = 0
    int nGood = 0
    int nMod = 0
    int nWeak = 0
    int tracked = 0
    int resolvedAll = 0
    int reached = 0
    int favHit = 0
    float sumMfe = 0.0
    float sumMae = 0.0

// =============================================================================
// 4. PERSISTENT STATE
// =============================================================================
var array<Zone> zones = array.new<Zone>()
var Stats stats = Stats.new()

var float extHigh = na
var float extLow = na
var int extHighBar = 0
var int extLowBar = 0
var bool extHighBroken = true
var bool extLowBroken = true
var bool extHighSw = false
var bool extLowSw = false
var int extTrend = 0

var float intHigh = na
var float intLow = na
var int intHighBar = 0
var int intLowBar = 0
var bool intHighBroken = true
var bool intLowBroken = true
var bool intHighSw = false
var bool intLowSw = false
var int intTrend = 0

var float rngExtH = na
var float rngExtL = na
var float rngIntH = na
var float rngIntL = na

var float eqHighLvl = na
var float eqLowLvl = na
var bool eqHighOn = false
var bool eqLowOn = false

var int bullBrkBar = -1
var float bullBrkW = 0.0
var string bullBrkTxt = "None"
var bool bullBrkShift = false
var bool bullBrkExt = false
var int bullBrkSwing = 0
var int bearBrkBar = -1
var float bearBrkW = 0.0
var string bearBrkTxt = "None"
var bool bearBrkShift = false
var bool bearBrkExt = false
var int bearBrkSwing = 0

var int sslBar = -1
var float sslStr = 0.0
var string sslTxt = "None"
var int bslBar = -1
var float bslStr = 0.0
var string bslTxt = "None"

var array<box> dBoxes = array.new<box>()
var array<line> dLines = array.new<line>()
var array<label> dLabels = array.new<label>()

// constant lookup tables
var array<string> clsNames = array.from("Below threshold", "Moderate", "Good", "High quality", "Exceptional")
var array<string> stFvgNames = array.from("Untouched", "First touch", "Partially filled", "50%+ filled", "Fully filled", "Invalidated")
var array<string> stObNames = array.from("Fresh", "First retest", "Partial penetration", "Deep penetration", "Fully mitigated", "Invalidated")
var array<float> freshArr = array.from(1.0, 0.65, 0.35, 0.1, 0.0, 0.0)
var array<string> compNames = array.from("ATR size", "Displacement", "Prem/Disc location", "BOS/MSS", "Liquidity sweep", "Volume", "FVG/OB confluence", "HTF alignment", "Freshness")
var array<float> wFvg = array.from(wF_size, wF_disp * mDisp, wF_pd * mPd, wF_str * mStr, wF_liq * mLiq, useVol ? wF_vol : 0.0, 0.0, wF_htf * mHtf, wF_fresh)
var array<float> wOb = array.from(wO_atr, wO_disp * mDisp, wO_pd * mPd, wO_str * mStr, wO_liq * mLiq, useVol ? wO_vol : 0.0, wO_conf, wO_htf * mHtf, wO_fresh)

// =============================================================================
// 5. PER-BAR SERIES
// =============================================================================
float trRaw = ta.tr
float trAvg = ta.sma(trRaw, 50)
float trClamped = math.min(trRaw, atrClamp * nz(trAvg[1], trRaw))
float atrV = ta.rma(trClamped, atrLen)
float avgRng = ta.sma(high - low, 20)
float volSma = ta.sma(volume, volLen)

float extPH = ta.pivothigh(high, extLen, extLen)
float extPL = ta.pivotlow(low, extLen, extLen)
float intPH = ta.pivothigh(high, intLen, intLen)
float intPL = ta.pivotlow(low, intLen, intLen)

int bullRun = close > open ? nz(bullRun[1]) + 1 : 0
int bearRun = close < open ? nz(bearRun[1]) + 1 : 0

bool bullDispC = close > open and (close - open) >= dispMinEff * atrV
bool bearDispC = close < open and (open - close) >= dispMinEff * atrV
bool bullDispRecent = bullDispC or bullDispC[1] or bullDispC[2]
bool bearDispRecent = bearDispC or bearDispC[1] or bearDispC[2]

int tfMs = timeframe.in_seconds(timeframe.period) * 1000

// =============================================================================
// 6. HIGHER-TIMEFRAME DATA
// =============================================================================
// Compact HTF context: structure trend, dealing range, ATR, latest unmitigated
// FVG and OB per side. Called inside request.security; `off` = 1 returns the
// last completed HTF bar, 0 returns the developing bar.
htfPack(int pivLen, int aLen, float minFvg, int off) =>
    float a = ta.atr(aLen)
    float ph = ta.pivothigh(high, pivLen, pivLen)
    float pl = ta.pivotlow(low, pivLen, pivLen)
    var float sh = na
    var float sl = na
    var bool shB = true
    var bool slB = true
    var int trd = 0
    var float rH = na
    var float rL = na
    var float bfT = na
    var float bfB = na
    var float sfT = na
    var float sfB = na
    var float boT = na
    var float boB = na
    var float soT = na
    var float soB = na
    if not na(ph)
        sh := ph
        shB := false
    if not na(pl)
        sl := pl
        slB := false
    if not na(sh) and not na(sl) and sh > sl
        rH := sh
        rL := sl
    bool upB = not shB and close > sh
    bool dnB = not slB and close < sl
    if not na(bfB) and close < bfB
        bfT := na
        bfB := na
    if not na(sfT) and close > sfT
        sfT := na
        sfB := na
    if not na(boB) and close < boB
        boT := na
        boB := na
    if not na(soT) and close > soT
        soT := na
        soB := na
    if low > high[2] and (low - high[2]) >= minFvg * a
        bfT := low
        bfB := high[2]
    if high < low[2] and (low[2] - high) >= minFvg * a
        sfT := low[2]
        sfB := high
    if upB
        shB := true
        trd := 1
        float bl = na
        for i = 1 to 10
            if close[i] < open[i] and (na(bl) or low[i] < bl)
                bl := low[i]
                boT := high[i]
                boB := low[i]
    if dnB
        slB := true
        trd := -1
        float bh = na
        for i = 1 to 10
            if close[i] > open[i] and (na(bh) or high[i] > bh)
                bh := high[i]
                soT := high[i]
                soB := low[i]
    [float(trd[off]), rH[off], rL[off], a[off], bfT[off], bfB[off], sfT[off], sfB[off], boT[off], boB[off], soT[off], soB[off]]

string presetTf1 = isScalp ? "15" : isSwing ? "D" : "60"
string presetTf2 = isScalp ? "60" : isSwing ? "W" : "240"
string tf1 = slotIn1 == "Preset" ? presetTf1 : slotIn1
string tf2 = slotIn2 == "Preset" ? presetTf2 : slotIn2
string tf3 = slotIn3 == "Preset" ? "Off" : slotIn3
bool on1 = tf1 != "Off" and timeframe.in_seconds(tf1) > timeframe.in_seconds(timeframe.period)
bool on2 = tf2 != "Off" and timeframe.in_seconds(tf2) > timeframe.in_seconds(timeframe.period)
bool on3 = tf3 != "Off" and timeframe.in_seconds(tf3) > timeframe.in_seconds(timeframe.period)
// Only the mode in use gets a real HTF request; the other runs on the chart timeframe (negligible cost).
string cTf1 = on1 and confirmedOnly ? tf1 : timeframe.period
string cTf2 = on2 and confirmedOnly ? tf2 : timeframe.period
string cTf3 = on3 and confirmedOnly ? tf3 : timeframe.period
string dTf1 = on1 and not confirmedOnly ? tf1 : timeframe.period
string dTf2 = on2 and not confirmedOnly ? tf2 : timeframe.period
string dTf3 = on3 and not confirmedOnly ? tf3 : timeframe.period

[p1a, p1b, p1c, p1d, p1e, p1f, p1g, p1h, p1i, p1j, p1k, p1l] = request.security(syminfo.tickerid, cTf1, htfPack(htfPiv, atrLen, thrRej, 1), lookahead = barmerge.lookahead_on)
[q1a, q1b, q1c, q1d, q1e, q1f, q1g, q1h, q1i, q1j, q1k, q1l] = request.security(syminfo.tickerid, dTf1, htfPack(htfPiv, atrLen, thrRej, 0), lookahead = barmerge.lookahead_off)
[p2a, p2b, p2c, p2d, p2e, p2f, p2g, p2h, p2i, p2j, p2k, p2l] = request.security(syminfo.tickerid, cTf2, htfPack(htfPiv, atrLen, thrRej, 1), lookahead = barmerge.lookahead_on)
[q2a, q2b, q2c, q2d, q2e, q2f, q2g, q2h, q2i, q2j, q2k, q2l] = request.security(syminfo.tickerid, dTf2, htfPack(htfPiv, atrLen, thrRej, 0), lookahead = barmerge.lookahead_off)
[p3a, p3b, p3c, p3d, p3e, p3f, p3g, p3h, p3i, p3j, p3k, p3l] = request.security(syminfo.tickerid, cTf3, htfPack(htfPiv, atrLen, thrRej, 1), lookahead = barmerge.lookahead_on)
[q3a, q3b, q3c, q3d, q3e, q3f, q3g, q3h, q3i, q3j, q3k, q3l] = request.security(syminfo.tickerid, dTf3, htfPack(htfPiv, atrLen, thrRej, 0), lookahead = barmerge.lookahead_off)

array<float> r1 = confirmedOnly ? array.from(p1a, p1b, p1c, p1d, p1e, p1f, p1g, p1h, p1i, p1j, p1k, p1l) : array.from(q1a, q1b, q1c, q1d, q1e, q1f, q1g, q1h, q1i, q1j, q1k, q1l)
array<float> r2 = confirmedOnly ? array.from(p2a, p2b, p2c, p2d, p2e, p2f, p2g, p2h, p2i, p2j, p2k, p2l) : array.from(q2a, q2b, q2c, q2d, q2e, q2f, q2g, q2h, q2i, q2j, q2k, q2l)
array<float> r3 = confirmedOnly ? array.from(p3a, p3b, p3c, p3d, p3e, p3f, p3g, p3h, p3i, p3j, p3k, p3l) : array.from(q3a, q3b, q3c, q3d, q3e, q3f, q3g, q3h, q3i, q3j, q3k, q3l)

matrix<float> htfM = matrix.new<float>(0, 12)
htfM.add_row(0, r1)
htfM.add_row(1, r2)
htfM.add_row(2, r3)

array<bool> slotOn = array.from(on1, on2, on3)
array<bool> slotSc = array.from(on1 and slotSc1, on2 and slotSc2, on3 and slotSc3)
array<string> slotTf = array.from(tf1, tf2, tf3)

// Previous day / week high-low: [1] + lookahead_on returns the last completed period only.
bool dOk = timeframe.in_seconds(timeframe.period) < timeframe.in_seconds("D")
bool wOk = timeframe.in_seconds(timeframe.period) < timeframe.in_seconds("W")
[pdhR, pdlR] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwhR, pwlR] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
float pdhL = useDaily and dOk ? pdhR : na
float pdlL = useDaily and dOk ? pdlR : na
float pwhL = useWeekly and wOk ? pwhR : na
float pwlL = useWeekly and wOk ? pwlR : na

int hrSlot = htfRngSlot - 1
bool htfRngOk = useHtfRange and slotOn.get(hrSlot)
float rngHtfH = htfRngOk ? htfM.get(hrSlot, 1) : na
float rngHtfL = htfRngOk ? htfM.get(hrSlot, 2) : na
bool useHtfAtr = atrSrc == "Higher timeframe (slot 1)" and on1 and not na(htfM.get(0, 3))
float atrNorm = useHtfAtr ? htfM.get(0, 3) : atrV

// =============================================================================
// 7. FUNCTIONS
// =============================================================================
f_clamp(float x) =>
    math.max(0.0, math.min(1.0, x))

f_pos(string s) =>
    switch s
        "Top right" => position.top_right
        "Top left" => position.top_left
        "Bottom right" => position.bottom_right
        "Bottom left" => position.bottom_left
        "Middle right" => position.middle_right
        "Middle left" => position.middle_left
        => position.top_right

f_lblSize(string s) =>
    switch s
        "tiny" => size.tiny
        "small" => size.small
        => size.normal

f_cls(float s) =>
    s >= 90.0 ? 4 : s >= 80.0 ? 3 : s >= 70.0 ? 2 : s >= 60.0 ? 1 : 0

f_dist(Zone z) =>
    close >= z.bot and close <= z.top ? 0.0 : math.min(math.abs(close - z.top), math.abs(close - z.bot))

f_byId(int uid) =>
    Zone r = na
    for z in zones
        if z.uid == uid
            r := z
    r

f_statusName(Zone z) =>
    z.isFvg ? stFvgNames.get(z.status) : stObNames.get(z.status)

f_zoneColor(Zone z) =>
    z.isFvg ? (z.isBull ? colBullFvg : colBearFvg) : (z.isBull ? colBullOb : colBearOb)

// Displacement quality of ONE candle (0..1), direction aware.
f_dispScore(bool isBull, float o, float h, float l, float c, float a, int runLen, float avgR) =>
    float rng = math.max(h - l, syminfo.mintick)
    float body = math.abs(c - o)
    bool dirOk = isBull ? c > o : c < o
    float fBody = f_clamp(body / a / dispFullBody)
    float fBR = f_clamp((body / rng - 0.35) / 0.55)
    float cp = isBull ? (c - l) / rng : (h - c) / rng
    float fCP = f_clamp((cp - 0.5) / 0.45)
    float opp = isBull ? (h - c) / rng : (c - l) / rng
    float fWick = 1.0 - f_clamp(opp / 0.4)
    float fRun = f_clamp((runLen - 1.0) / 2.0)
    float fExp = f_clamp((rng / avgR - 1.0) / (dispFullExp - 1.0))
    float s = 0.25 * fBody + 0.15 * fBR + 0.15 * fCP + 0.10 * fWick + 0.10 * fRun + 0.25 * fExp
    dirOk ? s : 0.0

f_sizeFrac(float r) =>
    r < thrRej ? 0.0 : r < thrWeak ? 0.25 : r < thrMod ? 0.55 : r < thrStrong ? 0.85 : 1.0

f_sizeName(float r) =>
    r < thrRej ? "Rejected" : r < thrWeak ? "Weak" : r < thrMod ? "Moderate" : r < thrStrong ? "Strong" : "Very strong"

f_obAtrFrac(float r) =>
    float f = 0.0
    if r < 0.3
        f := 0.0
    else if r < 0.8
        f := (r - 0.3) / 0.5
    else if r <= 2.0
        f := 1.0
    else if r <= 3.0
        f := 1.0 - 0.6 * (r - 2.0)
    else
        f := 0.2
    f

// Volume evidence (0..1): displacement RVOL, quiet pre-move volume, 3-bar confirmation.
f_volFrac(float vDisp, float vSma, float vPre, float v3) =>
    float res = 0.0
    if useVol and not na(vSma) and vSma > 0 and not na(vDisp) and not na(vPre) and not na(v3)
        float a = f_clamp((vDisp / vSma - 1.0) / (volHigh - 1.0))
        float pre = vPre / vSma
        float b = pre <= 0.9 ? 1.0 : f_clamp(1.0 - (pre - 0.9) / 0.4)
        float c = f_clamp((v3 / (3.0 * vSma) - 0.8) / 0.7)
        res := 0.5 * a + 0.25 * b + 0.25 * c
    res

// Premium / discount fraction for ONE range. Returns [fraction -1..1, position 0..1].
f_pdOne(bool isBull, float mid, float hi, float lo) =>
    float rg = hi - lo
    float p = rg > 0 ? (mid - lo) / rg : 0.5
    float q = f_clamp(isBull ? p : 1.0 - p)
    float eq = eqTolPct / 100.0
    float sw = sweetPct / 100.0
    float fr = 0.0
    if q <= sw
        fr := 1.0
    else if q < 0.5 - eq
        fr := 1.0 - 0.4 * (q - sw) / math.max(0.5 - eq - sw, 0.0001)
    else if q <= 0.5 + eq
        fr := -0.5
    else
        fr := -0.3 - 0.3 * f_clamp((q - 0.5 - eq) / math.max(0.5 - eq, 0.0001))
    [fr, p]

f_loc(float p) =>
    float eq = eqTolPct / 100.0
    p < 0.5 - eq ? "Discount" : p > 0.5 + eq ? "Premium" : "Equilibrium"

// Averages every enabled+valid range. Returns [fraction, valid, primary position, detail text].
f_pdEval(bool isBull, float mid) =>
    bool vE = useExtRange and rngExtH > rngExtL
    bool vI = useIntRange and rngIntH > rngIntL
    bool vH = htfRngOk and rngHtfH > rngHtfL
    [frE, pE] = f_pdOne(isBull, mid, nz(rngExtH), nz(rngExtL))
    [frI, pI] = f_pdOne(isBull, mid, nz(rngIntH), nz(rngIntL))
    [frH, pH] = f_pdOne(isBull, mid, nz(rngHtfH), nz(rngHtfL))
    float acc = 0.0
    int n = 0
    int nFav = 0
    float pPrim = na
    string t = ""
    if vE
        acc += frE
        n += 1
        nFav += frE > 0.5 ? 1 : 0
        pPrim := na(pPrim) ? pE : pPrim
        t += "Ext " + f_loc(pE) + " " + str.tostring(pE * 100, "0") + "%"
    if vI
        acc += frI
        n += 1
        nFav += frI > 0.5 ? 1 : 0
        pPrim := na(pPrim) ? pI : pPrim
        t += (t == "" ? "" : " | ") + "Int " + f_loc(pI) + " " + str.tostring(pI * 100, "0") + "%"
    if vH
        acc += frH
        n += 1
        nFav += frH > 0.5 ? 1 : 0
        pPrim := na(pPrim) ? pH : pPrim
        t += (t == "" ? "" : " | ") + "HTF " + f_loc(pH) + " " + str.tostring(pH * 100, "0") + "%"
    float avg = n > 0 ? acc / n : 0.0
    if nFav >= 2
        avg := math.min(1.0, avg + 0.1 * (nFav - 1))
    [avg, n > 0, pPrim, n > 0 ? t : "n/a"]

// HTF alignment, averaged over the contributing slots (not all have to agree).
f_htfAlign(bool isBull, float zTop, float zBot) =>
    float acc = 0.0
    int n = 0
    string t = ""
    float mid = (zTop + zBot) / 2.0
    for s = 0 to 2
        if slotSc.get(s)
            float trd = htfM.get(s, 0)
            float ft = htfM.get(s, isBull ? 4 : 6)
            float fb = htfM.get(s, isBull ? 5 : 7)
            float ot = htfM.get(s, isBull ? 8 : 10)
            float obb = htfM.get(s, isBull ? 9 : 11)
            float rH = htfM.get(s, 1)
            float rL = htfM.get(s, 2)
            bool inF = not na(ft) and zBot < ft and zTop > fb
            bool inO = not na(ot) and zBot < ot and zTop > obb
            bool dsc = rH > rL and (isBull ? mid < (rH + rL) / 2.0 : mid > (rH + rL) / 2.0)
            bool stOk = isBull ? trd == 1 : trd == -1
            float f = (inF ? 0.35 : 0.0) + (inO ? 0.30 : 0.0) + (dsc ? 0.15 : 0.0) + (stOk ? 0.20 : 0.0)
            acc += f
            n += 1
            string part = slotTf.get(s) + ":" + (inF ? "FVG " : "") + (inO ? "OB " : "") + (dsc ? (isBull ? "Disc " : "Prem ") : "") + (stOk ? "Struct" : "")
            t += (t == "" ? "" : " | ") + str.trim(part)
    [n > 0 ? acc / n : 0.0, n > 0, n > 0 ? t : "n/a"]

// Structure break inside the window. Returns [weight, text, is CHoCH/MSS].
f_structEval(bool isBull, int minBar) =>
    float w = 0.0
    string t = "None"
    bool sh = false
    if isBull
        if bullBrkBar >= minBar
            w := bullBrkW
            t := bullBrkTxt
            sh := bullBrkShift
    else
        if bearBrkBar >= minBar
            w := bearBrkW
            t := bearBrkTxt
            sh := bearBrkShift
    [w, t, sh]

// Liquidity sweep before the zone. A sweep + MSS/CHoCH sequence earns full credit.
f_liqEval(bool isBull, int minBar, bool shift) =>
    float s = 0.0
    string t = "None"
    if isBull
        if sslBar >= minBar
            s := sslStr
            t := sslTxt
    else
        if bslBar >= minBar
            s := bslStr
            t := bslTxt
    float fr = s > 0 ? (shift ? 1.0 : s * 0.85) : 0.0
    [fr, t]

f_sweep(bool hiSide, float lvl, float w, string nm) =>
    bool hit = not na(lvl) and (hiSide ? (high > lvl and close < lvl) : (low < lvl and close > lvl))
    [hit ? w : 0.0, nm]

f_pick(array<float> s, array<string> n) =>
    float best = 0.0
    string nm = ""
    for i = 0 to s.size() - 1
        if s.get(i) > best
            best := s.get(i)
            nm := n.get(i)
    [best, nm]

f_weightsFor(Zone z) =>
    array<float> w = z.isFvg ? wFvg.copy() : wOb.copy()
    if not z.pdOk
        w.set(2, 0.0)
    if not z.volOk
        w.set(5, 0.0)
    if not z.htfOk
        w.set(7, 0.0)
    w

f_fracs(Zone z) =>
    array.from(z.fSize, z.fDisp, z.fPD, z.fStruct, z.fLiq, z.fVol, z.fConf, z.fHtf, freshArr.get(z.status))

f_rescore(Zone z) =>
    array<float> w = f_weightsFor(z)
    array<float> f = f_fracs(z)
    float num = 0.0
    float den = 0.0
    for i = 0 to 8
        num += w.get(i) * f.get(i)
        den += w.get(i)
    float base = den > 0 ? 100.0 * num / den : 0.0
    float bonus = z.isFvg ? z.fConf * confBonus : 0.0
    z.score := math.max(0.0, math.min(100.0, base + bonus))
    z.cls := f_cls(z.score)
    z.score

f_dup(bool isB, bool isF, float zt, float zb, int fb) =>
    bool d = false
    for z in zones
        if z.isFvg == isF and z.isBull == isB
            float inter = math.min(zt, z.top) - math.max(zb, z.bot)
            float minH = math.min(zt - zb, z.top - z.bot)
            bool sameOrigin = not isF and z.formBar == fb
            bool heavy = z.status < 4 and inter > 0 and minH > 0 and inter / minH >= 0.8
            if sameOrigin or heavy
                d := true
    d

// FVG relationship to an OB: strength 0..1 and a readable name.
f_overlapSt(Zone fz, Zone oz) =>
    float inter = math.min(fz.top, oz.top) - math.max(fz.bot, oz.bot)
    float st = 0.0
    if inter > 0
        bool fInO = fz.bot >= oz.bot and fz.top <= oz.top
        bool oInF = oz.bot >= fz.bot and oz.top <= fz.top
        if fInO
            st := 1.0
        else if oInF
            st := 0.9
        else
            st := 0.6 + 0.3 * f_clamp(inter / math.max(math.min(fz.top - fz.bot, oz.top - oz.bot), syminfo.mintick))
    else
        float lim = confNearAtr * atrV
        if lim > 0 and -inter <= lim
            st := 0.2 + 0.4 * (1.0 - (-inter) / lim)
    st

f_relName(Zone fz, Zone oz) =>
    float inter = math.min(fz.top, oz.top) - math.max(fz.bot, oz.bot)
    string rel = "None"
    if inter > 0
        bool fInO = fz.bot >= oz.bot and fz.top <= oz.top
        bool oInF = oz.bot >= fz.bot and oz.top <= fz.top
        rel := fInO ? "FVG inside OB" : oInF ? "OB inside FVG" : "Partial overlap"
    else if confNearAtr * atrV > 0 and -inter <= confNearAtr * atrV
        rel := "Nearby"
    rel

f_confPass(Zone nz) =>
    for o in zones
        if o.uid != nz.uid and o.isFvg != nz.isFvg and o.isBull == nz.isBull and o.status < 4 and math.abs(o.formBar - nz.formBar) <= confMaxBars
            Zone fz = nz.isFvg ? nz : o
            Zone oz = nz.isFvg ? o : nz
            float st = f_overlapSt(fz, oz)
            if st > 0
                string rel = f_relName(fz, oz)
                if st > nz.fConf
                    nz.fConf := st
                    nz.confTxt := rel
                    nz.partnerId := o.uid
                if st > o.fConf
                    o.fConf := st
                    o.confTxt := rel
                    o.partnerId := nz.uid
                    f_rescore(o)
    f_rescore(nz)

// Locate the OB candle for a structure break. Returns [OB offset, displacement offset, extreme offset].
f_findOb(bool isBull, int swingBar) =>
    int maxN = math.min(math.max(bar_index - swingBar, 3), 100)
    int k = 0
    float ext = isBull ? low : high
    for i = 0 to maxN
        float v = isBull ? low[i] : high[i]
        if isBull ? v < ext : v > ext
            ext := v
            k := i
    int j = -1
    for m = k to 0
        bool dirOk = isBull ? close[m] > open[m] : close[m] < open[m]
        if j < 0 and dirOk and math.abs(close[m] - open[m]) >= dispMinEff * atrV[m]
            j := m
    int ob = -1
    if j >= 0
        for m = j + 1 to k + 3
            bool opp = isBull ? close[m] < open[m] : close[m] > open[m]
            if ob < 0 and opp
                ob := m
    [ob, j, k]

f_buildFvg(bool isB, float zt, float zb, float dScore, float dAtr, float vFrac, bool vOk, int tStart, int tForm) =>
    Zone z = na
    float ratio = (zt - zb) / atrNorm
    [sw, stxt, sshift] = f_structEval(isB, bar_index - structWindow + 1)
    [lq, ltxt] = f_liqEval(isB, bar_index - 2 - sweepLb, sshift)
    [pdF, pdOk, pPrim, pdT] = f_pdEval(isB, (zt + zb) / 2.0)
    [hF, hOk, hT] = f_htfAlign(isB, zt, zb)
    if ratio >= thrRej and not f_dup(isB, true, zt, zb, bar_index - 1)
        z := Zone.new()
        stats.seq := stats.seq + 1
        z.uid := stats.seq
        z.isFvg := true
        z.isBull := isB
        z.top := zt
        z.bot := zb
        z.startTime := tStart
        z.formBar := bar_index - 1
        z.formTime := tForm
        z.confBar := bar_index
        z.confTime := time
        z.atrForm := atrV
        z.atrRatio := ratio
        z.dispAtr := dAtr
        z.pos := pPrim
        z.locTxt := na(pPrim) ? "n/a" : f_loc(pPrim)
        z.pdTxt := pdT
        z.sizeTxt := f_sizeName(ratio)
        z.fSize := f_sizeFrac(ratio)
        z.fDisp := dScore
        z.fPD := pdF
        z.pdOk := pdOk
        z.fStruct := sw
        z.structTxt := stxt
        z.fLiq := lq
        z.liqTxt := ltxt
        z.fVol := vFrac
        z.volOk := vOk
        z.fHtf := hF
        z.htfOk := hOk
        z.htfTxt := hT
        f_rescore(z)
    z

f_buildOb(bool isB, int swingBar, float brkW, string brkTxt, bool brkShift) =>
    Zone z = na
    [obO, jO, kO] = f_findOb(isB, swingBar)
    bool valid = obO >= 1 and jO >= 0
    int o0 = math.max(obO, 1)
    int j0 = math.max(jO, 0)
    int k0 = math.max(kO, 0)
    int obBar = bar_index - o0
    float oo = open[o0]
    float cc = close[o0]
    float hh = high[o0]
    float ll = low[o0]
    float bt = math.max(oo, cc)
    float bb = math.min(oo, cc)
    float zt = hh
    float zb = ll
    if obBoundary == "Body only"
        zt := bt
        zb := bb
    else if obBoundary == "Hybrid (body + wick %)"
        zt := bt + (hh - bt) * obWickPct / 100.0
        zb := bb - (bb - ll) * obWickPct / 100.0
    float rngAtr = (hh - ll) / atrV
    bool viol = false
    for i = 0 to o0 - 1
        if isB ? close[i] < zb : close[i] > zt
            viol := true
    float net = math.abs(close - close[o0 + 5])
    float path = 0.0
    for i = 0 to o0 + 4
        path += math.abs(close[i] - close[i + 1])
    float er = path > 0 ? net / path : 0.0
    float legMag = isB ? close - low[k0] : high[k0] - close
    float legAtr = legMag / atrV
    bool ok = valid and not viol and legAtr >= obMinLegAtr and rngAtr >= obMinRngAtr and rngAtr <= obMaxRngAtr and er >= obErMin
    [lq, ltxt] = f_liqEval(isB, obBar - sweepLb, brkShift)
    [pdF, pdOk, pPrim, pdT] = f_pdEval(isB, (zt + zb) / 2.0)
    [hF, hOk, hT] = f_htfAlign(isB, zt, zb)
    if ok and not f_dup(isB, false, zt, zb, obBar)
        float dJ = f_dispScore(isB, open[j0], high[j0], low[j0], close[j0], atrV[j0], isB ? bullRun[j0] : bearRun[j0], avgRng[j0])
        float vDisp = volume[j0]
        float vPre = (volume[j0 + 1] + volume[j0 + 2] + volume[j0 + 3]) / 3.0
        float v3 = volume[j0] + volume[j0 + 1] + volume[math.max(j0 - 1, 0)]
        float vF = f_volFrac(vDisp, volSma[j0], vPre, v3)
        bool vOk = useVol and not na(volSma[j0]) and volSma[j0] > 0
        stats.seq := stats.seq + 1
        z := Zone.new()
        z.uid := stats.seq
        z.isFvg := false
        z.isBull := isB
        z.top := zt
        z.bot := zb
        z.startTime := time[o0]
        z.formBar := obBar
        z.formTime := time[o0]
        z.confBar := bar_index
        z.confTime := time
        z.atrForm := atrV
        z.atrRatio := (zt - zb) / atrV
        z.dispAtr := math.abs(close[j0] - open[j0]) / atrV[j0]
        z.pos := pPrim
        z.locTxt := na(pPrim) ? "n/a" : f_loc(pPrim)
        z.pdTxt := pdT
        z.sizeTxt := str.tostring(rngAtr, "0.00") + " ATR candle"
        z.fSize := f_obAtrFrac(rngAtr)
        z.fDisp := (0.7 * dJ + 0.3 * f_clamp(legAtr / 3.0)) * (0.6 + 0.4 * f_clamp(er / 0.5))
        z.fPD := pdF
        z.pdOk := pdOk
        z.fStruct := brkW
        z.structTxt := brkTxt
        z.fLiq := lq
        z.liqTxt := ltxt
        z.fVol := vF
        z.volOk := vOk
        z.fHtf := hF
        z.htfOk := hOk
        z.htfTxt := hT
        f_rescore(z)
    z

// ----- text builders ---------------------------------------------------------
f_labelText(Zone z, bool merged, float scoreShown) =>
    string t = ""
    if lblType
        t += (z.isBull ? "BULLISH " : "BEARISH ") + (merged ? "FVG + OB" : z.isFvg ? "FVG" : "OB")
    if lblScore
        t += (t == "" ? "" : "\n") + "Score: " + str.tostring(scoreShown, "0")
    if lblSize
        t += (t == "" ? "" : "\n") + "Size: " + str.tostring(z.atrRatio, "0.00") + " ATR"
    if lblLoc
        t += (t == "" ? "" : "\n") + "Location: " + z.locTxt
    if lblStruct
        t += (t == "" ? "" : "\n") + "Structure: " + z.structTxt
    if lblLiq
        t += (t == "" ? "" : "\n") + "Liquidity: " + z.liqTxt
    if lblStatus
        t += (t == "" ? "" : "\n") + "Status: " + f_statusName(z)
    if lblConf
        t += (t == "" ? "" : "\n") + "Confluence: " + z.confTxt
    t

f_diag(Zone z) =>
    array<float> w = f_weightsFor(z)
    array<float> f = f_fracs(z)
    float den = 0.0
    for i = 0 to 8
        den += w.get(i)
    string t = (z.isBull ? "BULLISH " : "BEARISH ") + (z.isFvg ? "FVG" : "ORDER BLOCK") + " #" + str.tostring(z.uid) + " | Score " + str.tostring(z.score, "0.0") + " (" + clsNames.get(z.cls) + ")\n"
    t += "Formed " + str.format_time(z.formTime, "yyyy-MM-dd HH:mm", syminfo.timezone) + " | Confirmed " + str.format_time(z.confTime, "yyyy-MM-dd HH:mm", syminfo.timezone) + "\n"
    t += "Why detected: " + (z.isFvg ? "3-candle imbalance of " + str.tostring(z.atrRatio, "0.00") + " ATR (" + z.sizeTxt + ")" : "last opposing candle before displacement that broke structure") + "\n"
    t += "Displacement body: " + str.tostring(z.dispAtr, "0.00") + " ATR\n"
    t += "Components (PASS = fraction >= 0.5), points / max:\n"
    for i = 0 to 8
        if w.get(i) > 0
            float mx = den > 0 ? 100.0 * w.get(i) / den : 0.0
            string nm = (i == 0 and not z.isFvg) ? "ATR profile" : compNames.get(i)
            t += (f.get(i) >= 0.5 ? "  PASS " : "  FAIL ") + nm + ": " + str.tostring(mx * f.get(i), "0.0") + " / " + str.tostring(mx, "0.0") + "\n"
    if z.isFvg and z.fConf > 0
        t += "  + OB confluence bonus: " + str.tostring(z.fConf * confBonus, "0.0") + "\n"
    t += "Location: " + z.pdTxt + "\n"
    t += "Structure: " + z.structTxt + "\n"
    t += "Liquidity: " + z.liqTxt + "\n"
    t += "HTF: " + z.htfTxt + "\n"
    t += "Confluence: " + z.confTxt + "\n"
    t += "Status: " + f_statusName(z) + " | depth " + str.tostring(z.depth * 100, "0") + "% | touches " + str.tostring(z.touches)
    t

f_zname(Zone z) =>
    (z.isBull ? "bullish " : "bearish ") + (z.isFvg ? "FVG" : "OB") + " " + str.tostring(z.score, "0") + "/100 [" + str.tostring(z.bot, format.mintick) + " - " + str.tostring(z.top, format.mintick) + "]"

f_msg(string head, Zone z) =>
    "UFOB " + syminfo.ticker + " " + timeframe.period + " | " + head + " " + f_zname(z)

f_count(Zone z) =>
    stats.detected := stats.detected + 1
    if z.cls == 4
        stats.nExc := stats.nExc + 1
    else if z.cls == 3
        stats.nHigh := stats.nHigh + 1
    else if z.cls == 2
        stats.nGood := stats.nGood + 1
    else if z.cls == 1
        stats.nMod := stats.nMod + 1
    else
        stats.nWeak := stats.nWeak + 1
    stats.detected

f_nearest(bool isF, bool isB) =>
    Zone best = na
    float bd = 1e10
    for z in zones
        if z.isFvg == isF and z.isBull == isB and z.status < 4
            float d = f_dist(z)
            if d < bd
                bd := d
                best := z
    best

f_showZone(Zone z) =>
    bool ok = (dispMode != "FVG only" or z.isFvg) and (dispMode != "OB only" or not z.isFvg)
    if dispMode == "Overlapping FVG/OB only"
        ok := ok and z.partnerId > 0 and z.fConf >= 0.6
    ok := ok and z.score >= minScoreEff
    ok := ok and (not highOnly or z.score >= hiQ)
    if z.status >= 4 and not showMitigated
        ok := false
    if not showHist and bar_index - z.formBar > histBars
        ok := false
    if ok and z.active and proxAtr > 0 and f_dist(z) > proxAtr * atrV
        ok := false
    ok

// =============================================================================
// 8. BAR-LEVEL EVENTS (pure reads of state; state is mutated in the engine)
// =============================================================================
bool upExt = not extHighBroken and close > extHigh
bool dnExt = not extLowBroken and close < extLow
bool upInt = not intHighBroken and close > intHigh
bool dnInt = not intLowBroken and close < intLow
int upExtSwing = extHighBar
int dnExtSwing = extLowBar
int upIntSwing = intHighBar
int dnIntSwing = intLowBar

// Liquidity sweeps: wick through a level, close back inside.
[ssw1, ssn1] = f_sweep(false, pdlL, 0.90, "PDL")
[ssw2, ssn2] = f_sweep(false, pwlL, 1.00, "PWL")
[ssw3, ssn3] = f_sweep(false, useEqLiq and eqLowOn ? eqLowLvl : na, 0.85, "Equal lows")
[ssw4, ssn4] = f_sweep(false, useSwingLiq and not extLowSw and not extLowBroken ? extLow : na, 0.95, "External swing low")
[ssw5, ssn5] = f_sweep(false, useSwingLiq and not intLowSw and not intLowBroken ? intLow : na, 0.55, "Internal swing low")
[bsw1, bsn1] = f_sweep(true, pdhL, 0.90, "PDH")
[bsw2, bsn2] = f_sweep(true, pwhL, 1.00, "PWH")
[bsw3, bsn3] = f_sweep(true, useEqLiq and eqHighOn ? eqHighLvl : na, 0.85, "Equal highs")
[bsw4, bsn4] = f_sweep(true, useSwingLiq and not extHighSw and not extHighBroken ? extHigh : na, 0.95, "External swing high")
[bsw5, bsn5] = f_sweep(true, useSwingLiq and not intHighSw and not intHighBroken ? intHigh : na, 0.55, "Internal swing high")
[sslNow, sslNowTxt] = f_pick(array.from(ssw1, ssw2, ssw3, ssw4, ssw5), array.from(ssn1, ssn2, ssn3, ssn4, ssn5))
[bslNow, bslNowTxt] = f_pick(array.from(bsw1, bsw2, bsw3, bsw4, bsw5), array.from(bsn1, bsn2, bsn3, bsn4, bsn5))

// Event flags consumed by plots / alertcondition (set only on confirmed bars).
bool evNewBullFvg = false
bool evNewBearFvg = false
bool evNewBullOb = false
bool evNewBearOb = false
bool evConfl = false
bool evAppr = false
bool evEnter = false
bool evInval = false
bool evMitig = false
bool evTop = false
bool evUpBos = false
bool evUpShift = false
bool evDnBos = false
bool evDnShift = false

array<Zone> newZ = array.new<Zone>()
array<string> msgs = array.new_string()

// =============================================================================
// 9. ENGINE (confirmed bars only)
// =============================================================================
if barstate.isconfirmed and bar_index >= 150 and not na(atrV) and not na(avgRng)
    // ---- (a) structure breaks (close beyond an unbroken swing) -----------------
    bool anyUp = upExt or upInt
    bool anyDn = dnExt or dnInt
    if upExt
        bool choch = extTrend == -1
        bool mss = choch and bullDispRecent
        float w = mss ? 1.0 : choch ? 0.9 : 0.75
        extHighBroken := true
        extTrend := 1
        evUpBos := not choch
        evUpShift := choch
        if bullBrkBar != bar_index or w > bullBrkW
            bullBrkBar := bar_index
            bullBrkW := w
            bullBrkTxt := "Bullish Ext " + (mss ? "MSS" : choch ? "CHoCH" : "BOS")
            bullBrkShift := choch
            bullBrkExt := true
            bullBrkSwing := upExtSwing
    if upInt
        bool choch = intTrend == -1
        bool mss = choch and bullDispRecent
        float w = mss ? 0.6 : choch ? 0.5 : 0.4
        intHighBroken := true
        intTrend := 1
        if bullBrkBar != bar_index or w > bullBrkW
            bullBrkBar := bar_index
            bullBrkW := w
            bullBrkTxt := "Bullish Int " + (mss ? "MSS" : choch ? "CHoCH" : "BOS")
            bullBrkShift := choch
            bullBrkExt := false
            bullBrkSwing := upIntSwing
    if dnExt
        bool choch = extTrend == 1
        bool mss = choch and bearDispRecent
        float w = mss ? 1.0 : choch ? 0.9 : 0.75
        extLowBroken := true
        extTrend := -1
        evDnBos := not choch
        evDnShift := choch
        if bearBrkBar != bar_index or w > bearBrkW
            bearBrkBar := bar_index
            bearBrkW := w
            bearBrkTxt := "Bearish Ext " + (mss ? "MSS" : choch ? "CHoCH" : "BOS")
            bearBrkShift := choch
            bearBrkExt := true
            bearBrkSwing := dnExtSwing
    if dnInt
        bool choch = intTrend == 1
        bool mss = choch and bearDispRecent
        float w = mss ? 0.6 : choch ? 0.5 : 0.4
        intLowBroken := true
        intTrend := -1
        if bearBrkBar != bar_index or w > bearBrkW
            bearBrkBar := bar_index
            bearBrkW := w
            bearBrkTxt := "Bearish Int " + (mss ? "MSS" : choch ? "CHoCH" : "BOS")
            bearBrkShift := choch
            bearBrkExt := false
            bearBrkSwing := dnIntSwing

    // ---- (b) record liquidity sweeps ---------------------------------------------
    if sslNow > 0
        sslBar := bar_index
        sslStr := sslNow
        sslTxt := "SSL sweep (" + sslNowTxt + ")"
        extLowSw := ssw4 > 0 ? true : extLowSw
        intLowSw := ssw5 > 0 ? true : intLowSw
        eqLowOn := ssw3 > 0 ? false : eqLowOn
    if bslNow > 0
        bslBar := bar_index
        bslStr := bslNow
        bslTxt := "BSL sweep (" + bslNowTxt + ")"
        extHighSw := bsw4 > 0 ? true : extHighSw
        intHighSw := bsw5 > 0 ? true : intHighSw
        eqHighOn := bsw3 > 0 ? false : eqHighOn
    if eqLowOn and close < eqLowLvl
        eqLowOn := false
    if eqHighOn and close > eqHighLvl
        eqHighOn := false

    // ---- (c) confirmed pivots -> swing levels, equal highs/lows --------------------
    if not na(extPH)
        extHigh := extPH
        extHighBar := bar_index - extLen
        extHighBroken := false
        extHighSw := false
    if not na(extPL)
        extLow := extPL
        extLowBar := bar_index - extLen
        extLowBroken := false
        extLowSw := false
    if not na(intPH)
        if not na(intHigh) and math.abs(intPH - intHigh) <= eqTolAtr * atrV
            eqHighLvl := math.max(intPH, intHigh)
            eqHighOn := true
        intHigh := intPH
        intHighBar := bar_index - intLen
        intHighBroken := false
        intHighSw := false
    if not na(intPL)
        if not na(intLow) and math.abs(intPL - intLow) <= eqTolAtr * atrV
            eqLowLvl := math.min(intPL, intLow)
            eqLowOn := true
        intLow := intPL
        intLowBar := bar_index - intLen
        intLowBroken := false
        intLowSw := false

    // ---- (d) dealing ranges (committed only when the swing pair is significant) -------
    if not na(extHigh) and not na(extLow) and extHigh > extLow and (extHigh - extLow) >= rngMinAtr * atrV
        rngExtH := extHigh
        rngExtL := extLow
    if not na(intHigh) and not na(intLow) and intHigh > intLow and (intHigh - intLow) >= rngMinAtr * atrV * 0.5
        rngIntH := intHigh
        rngIntL := intLow

    // ---- (e) zone lifecycle + outcome tracking --------------------------------------
    for z in zones
        if z.active and z.confBar < bar_index
            float scBefore = z.score
            float hgt = math.max(z.top - z.bot, syminfo.mintick)
            bool touchedNow = z.isBull ? low <= z.top : high >= z.bot
            float dNow = f_clamp(z.isBull ? (z.top - low) / hgt : (high - z.bot) / hgt)
            z.depth := math.max(z.depth, dNow)
            bool entered = touchedNow and not z.inside
            if entered
                z.touches := z.touches + 1
                if scBefore >= aEnter
                    evEnter := true
                    msgs.push(f_msg("price entering", z))
            z.inside := touchedNow
            if touchedNow and na(z.touchBar) and not z.resolved
                z.touchBar := bar_index
                z.refPrice := z.isBull ? z.top : z.bot
            bool inv = false
            if invRule == "Close beyond zone"
                inv := z.isBull ? close < z.bot : close > z.top
            else if invRule == "Wick beyond zone"
                inv := z.isBull ? low < z.bot : high > z.top
            else if invRule == "Full-body penetration"
                inv := z.isBull ? math.max(open, close) < z.bot : math.min(open, close) > z.top
            else
                inv := z.isBull ? (anyDn and close < z.top) : (anyUp and close > z.bot)
            int newSt = z.status
            if inv
                newSt := 5
            else if z.depth > 0
                newSt := (z.touches <= 1 and z.depth < 0.25) ? 1 : z.depth < 0.5 ? 2 : z.depth < 1.0 ? 3 : 4
            newSt := math.max(newSt, z.status)
            if newSt != z.status
                z.status := newSt
                f_rescore(z)
                if newSt == 5 and scBefore >= aInval
                    evInval := true
                    msgs.push(f_msg("zone INVALIDATED", z))
                if newSt == 4 and scBefore >= aMitig
                    evMitig := true
                    msgs.push(f_msg("zone MITIGATED", z))
            if z.status >= 4
                z.active := false
                z.endBar := bar_index
                z.endTime := time
            if z.active and z.status == 0 and not z.approachSent
                float gapD = z.isBull ? close - z.top : z.bot - close
                if gapD > 0 and gapD <= apprAtr * atrV
                    z.approachSent := true
                    if scBefore >= aAppr
                        evAppr := true
                        msgs.push(f_msg("price approaching", z))
        if not z.resolved
            if not na(z.touchBar)
                float rp = z.refPrice
                z.mfe := math.max(z.mfe, (z.isBull ? high - rp : rp - low) / z.atrForm)
                z.mae := math.max(z.mae, (z.isBull ? rp - low : high - rp) / z.atrForm)
                if bar_index - z.touchBar >= statsHorizon
                    z.resolved := true
                    stats.resolvedAll := stats.resolvedAll + 1
                    stats.reached := stats.reached + 1
                    stats.sumMfe := stats.sumMfe + z.mfe
                    stats.sumMae := stats.sumMae + z.mae
                    if z.mfe >= statsExc
                        stats.favHit := stats.favHit + 1
            else if bar_index - z.confBar >= statsHorizon
                z.resolved := true
                stats.resolvedAll := stats.resolvedAll + 1

    // ---- (f) new FVG -------------------------------------------------------------------
    bool bullFvg = low > high[2]
    bool bearFvg = high < low[2]
    if bullFvg or bearFvg
        bool isB = bullFvg
        float zt = isB ? low : low[2]
        float zb = isB ? high[2] : high
        float dScore = f_dispScore(isB, open[1], high[1], low[1], close[1], atrV[1], isB ? bullRun[1] : bearRun[1], avgRng[1])
        float dAtr = math.abs(close[1] - open[1]) / atrV[1]
        float vPre = (volume[2] + volume[3] + volume[4]) / 3.0
        float v3 = volume + volume[1] + volume[2]
        float vFrac = f_volFrac(volume[1], volSma[1], vPre, v3)
        bool vOk = useVol and not na(volSma[1]) and volSma[1] > 0
        Zone nz = f_buildFvg(isB, zt, zb, dScore, dAtr, vFrac, vOk, time[2], time[1])
        if not na(nz)
            f_count(nz)
            if nz.score >= storeFloor
                zones.push(nz)
                newZ.push(nz)
                stats.tracked := stats.tracked + 1

    // ---- (g) new order blocks ------------------------------------------------------------
    if bullBrkBar == bar_index and (not obReqExt or bullBrkExt)
        Zone nzo = f_buildOb(true, bullBrkSwing, bullBrkW, bullBrkTxt, bullBrkShift)
        if not na(nzo)
            f_count(nzo)
            if nzo.score >= storeFloor
                zones.push(nzo)
                newZ.push(nzo)
                stats.tracked := stats.tracked + 1
    if bearBrkBar == bar_index and (not obReqExt or bearBrkExt)
        Zone nzo = f_buildOb(false, bearBrkSwing, bearBrkW, bearBrkTxt, bearBrkShift)
        if not na(nzo)
            f_count(nzo)
            if nzo.score >= storeFloor
                zones.push(nzo)
                newZ.push(nzo)
                stats.tracked := stats.tracked + 1

    // ---- (h) FVG / OB confluence, then new-zone alerts ----------------------------------------
    for nz in newZ
        f_confPass(nz)
    for nz in newZ
        if nz.isFvg and nz.isBull and nz.score >= aNewFvg
            evNewBullFvg := true
            msgs.push(f_msg("NEW", nz))
        if nz.isFvg and not nz.isBull and nz.score >= aNewFvg
            evNewBearFvg := true
            msgs.push(f_msg("NEW", nz))
        if not nz.isFvg and nz.isBull and nz.score >= aNewOb
            evNewBullOb := true
            msgs.push(f_msg("NEW", nz))
        if not nz.isFvg and not nz.isBull and nz.score >= aNewOb
            evNewBearOb := true
            msgs.push(f_msg("NEW", nz))
        if nz.fConf >= 0.6 and nz.score >= aConfl
            evConfl := true
            msgs.push(f_msg("FVG/OB CONFLUENCE (" + nz.confTxt + ")", nz))
        if nz.score >= aTop
            evTop := true
            msgs.push(f_msg("TOP-TIER (90+)", nz))

    // ---- (i) prune ------------------------------------------------------------------------------
    while zones.size() > maxStore
        int rm = 0
        for i = 0 to zones.size() - 1
            if not zones.get(i).active and zones.get(i).resolved
                rm := i
                break
        zones.remove(rm)

    if alertFnOn and msgs.size() > 0
        for m in msgs
            alert(m, alert.freq_once_per_bar_close)

// =============================================================================
// 10. PLOTS & ALERT CONDITIONS
// =============================================================================
plotshape(showStruct and evUpBos, "Ext bullish BOS", shape.triangleup, location.belowbar, color.new(colBullFvg, 20), size=size.tiny, text="BOS")
plotshape(showStruct and evUpShift, "Ext bullish CHoCH/MSS", shape.triangleup, location.belowbar, color.new(colBullFvg, 0), size=size.tiny, text="CHoCH")
plotshape(showStruct and evDnBos, "Ext bearish BOS", shape.triangledown, location.abovebar, color.new(colBearFvg, 20), size=size.tiny, text="BOS")
plotshape(showStruct and evDnShift, "Ext bearish CHoCH/MSS", shape.triangledown, location.abovebar, color.new(colBearFvg, 0), size=size.tiny, text="CHoCH")

alertcondition(evNewBullFvg, "New high-quality bullish FVG", "UFOB: new high-quality bullish FVG")
alertcondition(evNewBearFvg, "New high-quality bearish FVG", "UFOB: new high-quality bearish FVG")
alertcondition(evNewBullOb, "New high-quality bullish OB", "UFOB: new high-quality bullish order block")
alertcondition(evNewBearOb, "New high-quality bearish OB", "UFOB: new high-quality bearish order block")
alertcondition(evConfl, "FVG/OB confluence detected", "UFOB: FVG/OB confluence detected")
alertcondition(evAppr, "Price approaching high-quality zone", "UFOB: price approaching a high-quality zone")
alertcondition(evEnter, "Price entering high-quality zone", "UFOB: price entering a high-quality zone")
alertcondition(evInval, "Zone invalidated", "UFOB: high-quality zone invalidated")
alertcondition(evMitig, "Zone mitigated", "UFOB: high-quality zone mitigated")
alertcondition(evTop, "New 90+ quality zone", "UFOB: new 90+ quality zone")

// =============================================================================
// 11. RENDERING (view of stored state, last bar only)
// =============================================================================
var table dash = showDash ? table.new(f_pos(dashPosIn), 2, 24, bgcolor=color.new(#131722, 8), border_color=color.new(#363a45, 0), border_width=1, frame_color=color.new(#363a45, 0), frame_width=1) : na
var table insp = showInsp ? table.new(f_pos(inspPosIn), 1, 1, bgcolor=color.new(#131722, 8), border_color=color.new(#363a45, 0), border_width=1, frame_color=color.new(#363a45, 0), frame_width=1) : na

f_cell(int r, string a, string b, color bc, bool head) =>
    table.cell(dash, 0, r, a, text_color = head ? color.white : color.new(#b2b5be, 0), bgcolor = head ? color.new(#2a2e39, 0) : na, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, r, b, text_color = bc, bgcolor = head ? color.new(#2a2e39, 0) : na, text_size = size.small, text_halign = text.align_right)

f_scoreCol(Zone z) =>
    na(z) ? color.gray : z.score >= 80 ? color.lime : z.score >= 65 ? color.yellow : color.orange

f_scoreTxt(Zone z) =>
    na(z) ? "-" : str.tostring(z.score, "0") + "/100 (" + f_statusName(z) + ")"

if barstate.islast
    for b in dBoxes
        b.delete()
    for l in dLines
        l.delete()
    for lb in dLabels
        lb.delete()
    dBoxes.clear()
    dLines.clear()
    dLabels.clear()

    // ---- select zones ---------------------------------------------------------------------
    array<int> cand = array.new_int()
    array<float> keys = array.new_float()
    for i = 0 to math.max(zones.size() - 1, 0)
        if zones.size() > 0
            Zone cz = zones.get(i)
            if f_showZone(cz)
                cand.push(i)
                keys.push(nearestOnly ? f_dist(cz) : -cz.score)
    array<int> ord = keys.sort_indices(order.ascending)
    int lim = nearestOnly ? math.min(nearestN, maxZones) : maxZones
    int cnt = math.min(lim, cand.size())
    array<int> shown = array.new_int()
    array<int> shownIds = array.new_int()
    if cnt > 0
        for k = 0 to cnt - 1
            int zi = cand.get(ord.get(k))
            shown.push(zi)
            shownIds.push(zones.get(zi).uid)

    // ---- draw -----------------------------------------------------------------------------
    int rightFuture = time + extBars * tfMs
    string inspText = "No zone at this rank"
    if cnt > 0
        for k = 0 to cnt - 1
            Zone z = zones.get(shown.get(k))
            bool skip = false
            bool merged = false
            float zt = z.top
            float zb = z.bot
            float sc = z.score
            if mergeOn and z.partnerId > 0
                Zone pz = f_byId(z.partnerId)
                if not na(pz) and shownIds.includes(pz.uid)
                    if z.isFvg
                        merged := true
                        zt := math.max(z.top, pz.top)
                        zb := math.min(z.bot, pz.bot)
                        sc := math.max(z.score, pz.score)
                    else
                        skip := true
            if k + 1 == inspRank
                inspText := f_diag(z)
            if not skip
                bool ended = z.status >= 4
                int rightT = ended ? z.endTime : (extendOn ? rightFuture : z.confTime + 8 * tfMs)
                color base = merged ? (z.isBull ? colBullOb : colBearOb) : f_zoneColor(z)
                int transp = int(math.max(55.0, math.min(90.0, 92.0 - (sc - 55.0) * 0.8)))
                if ended
                    transp := 92
                bool strong = sc >= hiQ or z.fConf >= 0.6
                dBoxes.push(box.new(left=z.startTime, top=zt, right=rightT, bottom=zb, xloc=xloc.bar_time, border_color=color.new(base, strong ? 0 : 45), border_width=strong ? 2 : 1, border_style=ended ? line.style_dashed : line.style_solid, bgcolor=color.new(base, transp)))
                float midY = (zt + zb) / 2.0
                if showCE
                    dLines.push(line.new(z.startTime, midY, rightT, midY, xloc=xloc.bar_time, color=color.new(base, 30), style=line.style_dotted, width=1))
                if showLabels
                    string ttxt = diagTip ? f_diag(z) : ""
                    dLabels.push(label.new(rightT, midY, f_labelText(z, merged, sc), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(base, 25), textcolor=color.white, size=f_lblSize(lblSizeSel), tooltip=ttxt))

    // ---- dealing-range lines -------------------------------------------------------------------
    if showEqLines
        int x1 = time - 80 * tfMs
        int x2 = time + 10 * tfMs
        if not na(rngExtH) and not na(rngExtL)
            dLines.push(line.new(x1, rngExtH, x2, rngExtH, xloc=xloc.bar_time, color=color.new(color.gray, 30), style=line.style_solid))
            dLines.push(line.new(x1, rngExtL, x2, rngExtL, xloc=xloc.bar_time, color=color.new(color.gray, 30), style=line.style_solid))
            dLines.push(line.new(x1, (rngExtH + rngExtL) / 2, x2, (rngExtH + rngExtL) / 2, xloc=xloc.bar_time, color=color.new(color.orange, 20), style=line.style_dashed))
        if useIntRange and not na(rngIntH) and not na(rngIntL)
            dLines.push(line.new(x1, (rngIntH + rngIntL) / 2, x2, (rngIntH + rngIntL) / 2, xloc=xloc.bar_time, color=color.new(color.aqua, 30), style=line.style_dotted))

    // ---- dashboard -------------------------------------------------------------------------------
    if showDash
        int trendNow = extTrend != 0 ? extTrend : intTrend
        float biasAcc = 0.0
        int biasN = 0
        for s = 0 to 2
            if slotOn.get(s)
                biasAcc += htfM.get(s, 0)
                biasN += 1
        string biasTxt = biasN == 0 ? "n/a" : (biasAcc > 0 ? "Bullish" : biasAcc < 0 ? "Bearish" : "Neutral") + " (" + str.tostring(math.abs(biasAcc), "0") + "/" + str.tostring(biasN) + ")"
        float rH = useExtRange and not na(rngExtH) ? rngExtH : useIntRange and not na(rngIntH) ? rngIntH : rngHtfH
        float rL = useExtRange and not na(rngExtL) ? rngExtL : useIntRange and not na(rngIntL) ? rngIntL : rngHtfL
        string rngTxt = na(rH) or na(rL) ? "n/a" : str.tostring(rL, format.mintick) + " - " + str.tostring(rH, format.mintick)
        float pNow = (not na(rH) and not na(rL) and rH > rL) ? (close - rL) / (rH - rL) : na
        string locNow = na(pNow) ? "n/a" : f_loc(pNow) + " (" + str.tostring(f_clamp(pNow) * 100, "0") + "%)"
        Zone nBF = f_nearest(true, true)
        Zone nBO = f_nearest(false, true)
        Zone nSF = f_nearest(true, false)
        Zone nSO = f_nearest(false, false)
        float stD = (not na(nBF) and not na(nBO)) ? f_overlapSt(nBF, nBO) : 0.0
        float stS = (not na(nSF) and not na(nSO)) ? f_overlapSt(nSF, nSO) : 0.0
        string cfD = stD >= 0.6 ? "YES (" + f_relName(nBF, nBO) + ")" : stD > 0 ? "NEARBY" : "NO"
        string cfS = stS >= 0.6 ? "YES (" + f_relName(nSF, nSO) + ")" : stS > 0 ? "NEARBY" : "NO"
        int hq = 0
        for z in zones
            if z.active and z.score >= hiQ
                hq += 1
        color gr = color.new(#b2b5be, 0)
        f_cell(0, "ULTIMATE FVG / OB", syminfo.ticker + " " + timeframe.period, color.white, true)
        f_cell(1, "MARKET CONTEXT", "", color.white, true)
        f_cell(2, "Structure", trendNow == 1 ? "Bullish" : trendNow == -1 ? "Bearish" : "Neutral", trendNow == 1 ? color.lime : trendNow == -1 ? color.red : gr, false)
        f_cell(3, "HTF bias", biasTxt, gr, false)
        f_cell(4, "Dealing range", rngTxt, gr, false)
        f_cell(5, "Location", locNow, gr, false)
        f_cell(6, "NEAREST DEMAND", "", color.white, true)
        f_cell(7, "Bullish FVG", f_scoreTxt(nBF), f_scoreCol(nBF), false)
        f_cell(8, "Bullish OB", f_scoreTxt(nBO), f_scoreCol(nBO), false)
        f_cell(9, "Confluence", cfD, str.startswith(cfD, "YES") ? color.lime : gr, false)
        f_cell(10, "NEAREST SUPPLY", "", color.white, true)
        f_cell(11, "Bearish FVG", f_scoreTxt(nSF), f_scoreCol(nSF), false)
        f_cell(12, "Bearish OB", f_scoreTxt(nSO), f_scoreCol(nSO), false)
        f_cell(13, "Confluence", cfS, str.startswith(cfS, "YES") ? color.lime : gr, false)
        f_cell(14, "Active zones >= " + str.tostring(hiQ), str.tostring(hq), gr, false)
        f_cell(15, "Preset", presetSel + (detectTfs.includes(timeframe.period) ? "" : " (run on " + presetDetect + ")"), detectTfs.includes(timeframe.period) ? gr : color.orange, false)
        if showStats
            f_cell(16, "STATISTICS (not win rates)", "", color.white, true)
            f_cell(17, "Detected / tracked", str.tostring(stats.detected) + " / " + str.tostring(stats.tracked), gr, false)
            f_cell(18, "Exc/High/Good/Mod/Weak", str.tostring(stats.nExc) + "/" + str.tostring(stats.nHigh) + "/" + str.tostring(stats.nGood) + "/" + str.tostring(stats.nMod) + "/" + str.tostring(stats.nWeak), gr, false)
            f_cell(19, "Reached <= " + str.tostring(statsHorizon) + " bars", stats.resolvedAll > 0 ? str.tostring(100.0 * stats.reached / stats.resolvedAll, "0") + "% (n=" + str.tostring(stats.resolvedAll) + ")" : "n/a", gr, false)
            f_cell(20, "MFE >= " + str.tostring(statsExc, "0.0") + " ATR (of reached)", stats.reached > 0 ? str.tostring(100.0 * stats.favHit / stats.reached, "0") + "%" : "n/a", gr, false)
            f_cell(21, "Avg MFE / MAE (ATR)", stats.reached > 0 ? str.tostring(stats.sumMfe / stats.reached, "0.00") + " / " + str.tostring(stats.sumMae / stats.reached, "0.00") : "n/a", gr, false)
        else
            for r = 16 to 21
                f_cell(r, "", "", gr, false)

    // ---- zone inspector ----------------------------------------------------------------------------
    if showInsp
        table.cell(insp, 0, 0, inspText, text_color=color.white, text_size=size.small, text_halign=text.align_left)
